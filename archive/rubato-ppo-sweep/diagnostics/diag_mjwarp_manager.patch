+                    ]
+                    with open(os.path.join(out_dir, "geom_names.txt"), "w") as f:
+                        f.write("\n".join(names))
+                    _mj.mj_saveModel(mjm, os.path.join(out_dir, "model.mjb"), None)
+                except Exception:
+                    pass
+            dt = s._dt.numpy()
+            err = s._last_error.numpy()
+            acc = s._accepted_error.numpy()
+            nacon = int(d.nacon.numpy()[0])
+            wid = d.contact.worldid.numpy()[:nacon]
+            dist = d.contact.dist.numpy()[:nacon]
