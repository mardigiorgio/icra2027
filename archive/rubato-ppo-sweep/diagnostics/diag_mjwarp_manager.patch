+    def _log_adaptive_rich(cls) -> None:
+        """TEMP DIAGNOSTIC (2026-07-26, root-causing dt_min floor grinding): per-world npz telemetry.
+
+        Gated by NEWTON_ADAPTIVE_RICH=<output dir>. One row per manager frame: per-world inner
+        dt, last/accepted controller error, contact count, deepest penetration; plus the 32
+        deepest contacts (world, geom0, geom1, dist) and worlds reset this frame. Flushed to
+        <dir>/rich_NNNN.npz every 64 frames and at exit. Remove after the investigation.
+        """
+        import atexit
+
+        import numpy as _np
+
+        try:
+            out_dir = os.environ["NEWTON_ADAPTIVE_RICH"]
+            s = cls._solver
+            d = s.mjw_data
